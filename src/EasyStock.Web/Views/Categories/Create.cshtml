@model CategoryFormViewModel
@{
    ViewData["Title"] = "New category";
}

<h1 class="h3 mb-4">New category</h1>

<form asp-action="Create" method="post" class="col-lg-6">
    <partial name="_CategoryForm" model="Model" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}