@model List<CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categories</h1>
    <a asp-action="Create" class="btn btn-primary">New category</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No categories yet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th class="text-end">Items</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="fw-semibold">@category.Name</td>
                    <td class="text-muted">@category.Description</td>
                    <td class="text-end">@category.ItemCount</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}