@model ItemIndexViewModel
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Items</h1>
    <a asp-action="Create" class="btn btn-primary">New item</a>
</div>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-md-5">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-md-3">
        <select name="categoryId" asp-items="Model.Categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly" checked="@Model.LowStockOnly" />
            <label class="form-check-label" for="lowStockOnly">Low stock only</label>
        </div>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-fill">Filter</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No items match your filters.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Supplier</th>
                <th class="text-end">In stock</th>
                <th class="text-end">Minimum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.IsLowStock ? "table-warning" : null)">
                    <td class="fw-semibold">
                        @item.Name
                        @if (item.IsLowStock)
                        {
                            <span class="badge text-bg-warning ms-1">Low stock</span>
                        }
                    </td>
                    <td>@item.CategoryName</td>
                    <td class="text-muted">@(item.SupplierName ?? "—")</td>
                    <td class="text-end">@item.QuantityInStock</td>
                    <td class="text-end text-muted">@item.MinimumQuantity</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}