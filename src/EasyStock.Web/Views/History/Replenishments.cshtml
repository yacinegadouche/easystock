@model ReplenishmentHistoryViewModel
@{
    ViewData["Title"] = "Replenishments";
}

<h1 class="h3 mb-3">History</h1>
<partial name="_HistoryTabs" />

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label for="from" class="form-label small">From</label>
        <input type="date" id="from" name="from" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="to" class="form-label small">To</label>
        <input type="date" id="to" name="to" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="supplierId" class="form-label small">Supplier</label>
        <select id="supplierId" name="supplierId" asp-items="Model.Suppliers" class="form-select">
            <option value="">All suppliers</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-fill">Filter</button>
        <a asp-action="Replenishments" class="btn btn-link">Reset</a>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="alert alert-light border d-flex gap-4 mb-3">
    <div><span class="text-muted small d-block">Replenishments</span><strong>@Model.Replenishments.TotalCount</strong></div>
    <div><span class="text-muted small d-block">Units received</span><strong>@Model.TotalQuantity</strong></div>
</div>

@if (Model.Replenishments.Items.Count == 0)
{
    <p class="text-muted">No replenishments match your filters.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Item</th>
                <th>Supplier</th>
                <th class="text-end">Quantity</th>
                <th>Reference</th>
                <th>Reason</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Replenishments.Items)
            {
                <tr>
                    <td class="text-nowrap">@entry.OccurredAt.ToDisplay()</td>
                    <td class="fw-semibold">@entry.ItemName</td>
                    <td>@(entry.SupplierName ?? "—")</td>
                    <td class="text-end text-success fw-semibold">+@entry.Quantity</td>
                    <td>@(entry.ExternalReference ?? "—")</td>
                    <td class="text-muted">@entry.Reason</td>
                    <td class="text-muted">@entry.UserName</td>
                </tr>
            }
        </tbody>
    </table>
}

<partial name="_Pager" model="Model.Replenishments" />