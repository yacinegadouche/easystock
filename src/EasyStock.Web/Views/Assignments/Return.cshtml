@model AssignmentListItemViewModel
@{
    ViewData["Title"] = "Return equipment";
}

<h1 class="h3 mb-4">Return equipment</h1>

<dl class="row col-lg-6">
    <dt class="col-sm-4">Item</dt>
    <dd class="col-sm-8">@Model.ItemName</dd>
    <dt class="col-sm-4">Employee</dt>
    <dd class="col-sm-8">@Model.EmployeeName</dd>
    <dt class="col-sm-4">Quantity</dt>
    <dd class="col-sm-8">@Model.Quantity</dd>
    <dt class="col-sm-4">Assigned</dt>
    <dd class="col-sm-8">@Model.AssignedAt.ToDisplay() by @Model.AssignedBy</dd>
</dl>

<p>The quantity will be added back to stock.</p>

<form asp-action="Return" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-success">Confirm return</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>