@model AssignmentIndexViewModel
@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Assignments</h1>
    <a asp-action="Create" class="btn btn-primary">New assignment</a>
</div>

<ul class="nav nav-pills mb-3">
    @foreach (var status in Enum.GetValues<AssignmentStatusFilter>())
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Status == status ? "active" : null)" asp-action="Index" asp-route-status="@status">@status</a>
        </li>
    }
</ul>

<partial name="_AssignmentTable" model="Model.Assignments" />