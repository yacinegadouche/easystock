@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-primary">New user</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Username</th>
            <th>Full name</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr class="@(user.IsActive ? null : "text-muted")">
                <td class="fw-semibold">@user.Username</td>
                <td>@user.FullName</td>
                <td><span class="badge text-bg-secondary">@user.Role</span></td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light">Inactive</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">Reset password</a>
                </td>
            </tr>
        }
    </tbody>
</table>