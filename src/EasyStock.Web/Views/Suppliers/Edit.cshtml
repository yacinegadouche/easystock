@model SupplierFormViewModel
@{
    ViewData["Title"] = "Edit supplier";
}

<h1 class="h3 mb-4">Edit supplier</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <partial name="_SupplierForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}