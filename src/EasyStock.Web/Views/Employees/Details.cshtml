@model EmployeeDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">
            @Model.FullName
            @if (!Model.IsActive)
            {
                <span class="badge text-bg-light">Inactive</span>
            }
        </h1>
        <div class="text-muted">@Model.Email · @(Model.Department ?? "No department")</div>
    </div>
    <div class="text-nowrap">
        @if (Model.IsActive)
        {
            <a asp-controller="Assignments" asp-action="Create" asp-route-employeeId="@Model.Id" class="btn btn-primary">Assign equipment</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
    </div>
</div>

<h2 class="h5 mb-3">Assignment history</h2>
<partial name="_AssignmentTable" model="Model.Assignments" />