@model EmployeeIndexViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a asp-action="Create" class="btn btn-primary">New employee</a>
</div>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-md-6">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email or department" />
    </div>
    <div class="col-md-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="includeInactive" value="true" id="includeInactive" checked="@Model.IncludeInactive" />
            <label class="form-check-label" for="includeInactive">Include inactive</label>
        </div>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-fill">Filter</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </div>
</form>

@if (Model.Employees.Count == 0)
{
    <p class="text-muted">No employees match your filters.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th class="text-end">Assigned items</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr class="@(employee.IsActive ? null : "text-muted")">
                    <td class="fw-semibold">
                        <a asp-action="Details" asp-route-id="@employee.Id">@employee.FullName</a>
                        @if (!employee.IsActive)
                        {
                            <span class="badge text-bg-light ms-1">Inactive</span>
                        }
                    </td>
                    <td>@employee.Email</td>
                    <td>@(employee.Department ?? "—")</td>
                    <td class="text-end">@employee.ActiveAssignmentCount</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}