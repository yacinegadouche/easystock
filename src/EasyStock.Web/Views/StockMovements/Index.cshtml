@model List<StockMovementListItemViewModel>
@{
    ViewData["Title"] = "Stock movements";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Recent stock movements</h1>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-type="Entry" class="btn btn-success">Stock entry</a>
        <a asp-action="Create" asp-route-type="Exit" class="btn btn-danger">Stock exit</a>
        <a asp-action="Create" asp-route-type="Return" class="btn btn-outline-primary">Return to stock</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No stock movements yet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Item</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Stock after</th>
                <th>Reason</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movement in Model)
            {
                <tr>
                    <td class="text-nowrap">@movement.OccurredAt.ToDisplay()</td>
                    <td><span class="badge text-bg-secondary">@movement.Type.ToDisplayName()</span></td>
                    <td class="fw-semibold">@movement.ItemName</td>
                    <td class="text-end fw-semibold @(movement.IsIncrease ? "text-success" : "text-danger")">
                        @(movement.IsIncrease ? "+" : "−")@movement.Quantity
                    </td>
                    <td class="text-end">
                        @movement.QuantityAfter
                        @if (movement.LeftLowStock)
                        {
                            <span class="badge text-bg-warning ms-1">Low stock</span>
                        }
                    </td>
                    <td class="text-muted">
                        @movement.Reason
                        @if (movement.ExternalReference is not null)
                        {
                            <small class="d-block">Ref: @movement.ExternalReference</small>
                        }
                    </td>
                    <td class="text-muted">@movement.UserName</td>
                </tr>
            }
        </tbody>
    </table>
}