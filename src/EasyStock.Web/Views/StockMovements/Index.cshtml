@model List<StockMovementListItemViewModel>
@{
    ViewData["Title"] = "Stock movements";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Recent stock movements</h1>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-type="Entry" class="btn btn-success">Stock entry</a>
        <a asp-action="Create" asp-route-type="Exit" class="btn btn-danger">Stock exit</a>
        <a asp-action="Create" asp-route-type="Return" class="btn btn-outline-primary">Return to stock</a>
    </div>
</div>

<partial name="_MovementTable" model="Model" />